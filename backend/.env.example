# Copy this file to ".env" and adjust values. NEVER commit the real .env file.
APP_NAME="My API Integration Assistant"
ENVIRONMENT=development
# Comma-separated list of websites allowed to call this backend from a browser
CORS_ORIGINS=http://localhost:3000
# Where the SQLite database file lives (created automatically)
DATABASE_URL=sqlite:///./data/app.db

# --- AI (Claude) ---
# Your Claude API key from https://console.anthropic.com -> API Keys.
# Paste it after the = sign in your local .env file ONLY. Never commit it, never share it.
ANTHROPIC_API_KEY=
# Which Claude model to use, and how hard it should think (low / medium / high / xhigh / max)
AI_MODEL=claude-opus-5-5
AI_EFFORT=high

# --- Request Builder ---
# Set to true only if you need to test APIs running on your own computer or local network.
ALLOW_PRIVATE_NETWORK_REQUESTS=false

# --- Credentials ---
# Saved credentials are encrypted. By default the key is created automatically in data/credentials.key.
# BACK UP that file: without it, saved credentials cannot be decrypted. (Or set your own key here.)
CREDENTIALS_KEY=
# OAuth "sign in with browser" comes back to this address - register it in the app's OAuth client settings.
OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/callback
