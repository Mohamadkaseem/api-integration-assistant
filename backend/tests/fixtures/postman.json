{
  "info": {"_postman_id": "abc", "name": "Demo CRM Collection", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "SECRET-TOKEN-123", "type": "string"}]},
  "variable": [{"key": "base_url", "value": "https://www.example.com/crm/v3"}],
  "item": [
    {"name": "Accounts", "item": [
      {"name": "Upsert account", "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Zoho-oauthtoken SECRET-HEADER-456"}],
        "url": {"raw": "{{base_url}}/Accounts/upsert", "host": ["{{base_url}}"], "path": ["Accounts", "upsert"]},
        "body": {"mode": "raw", "raw": "{\"data\": [{\"Account_Name\": \"Acme\"}]}"}
      }, "response": [{"name": "Success", "code": 200, "body": "{\"data\": [{\"code\": \"SUCCESS\"}]}"}]},
      {"name": "Get account", "request": {
        "method": "GET",
        "url": {"raw": "{{base_url}}/Accounts/:id?fields=Account_Name", "host": ["{{base_url}}"], "path": ["Accounts", ":id"],
                "query": [{"key": "fields", "value": "Account_Name"}], "variable": [{"key": "id"}]}
      }}
    ]}
  ]
}
